@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "My Job Listings";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">My Job Listings</h2>
        <a asp-controller="Listings" asp-action="Create" class="btn btn-primary">+ Post a New Job</a>
    </div>

    @if (TempData["ListingMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["ListingMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You haven't posted any jobs yet.
            <a asp-controller="Listings" asp-action="Create">Post one now</a>.
        </div>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Job Title</th>
                    <th>Posted Date</th>
                    <th>Status</th>
                    <th>Applicants</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var listing in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.jobListId">
                                @listing.jobTitle
                            </a>
                        </td>
                        <td>@listing.postedDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (listing.isDeleted)
                            {
                                <span class="badge bg-dark">Deleted</span>
                            }
                            else if (listing.isClosed)
                            {
                                <span class="badge bg-secondary">Closed</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Open</span>
                            }
                        </td>
                        <td>@listing.applicantCount</td>
                        <td>
                            <a asp-controller="EmployerApplications" asp-action="ViewApplicants"
                               asp-route-jobListId="@listing.jobListId" class="btn btn-sm btn-outline-primary">
                                View Applicants
                            </a>

                            <form asp-controller="Listings" asp-action="Close" method="post" style="display:inline">
                                <input type="hidden" name="id" value="@listing.jobListId" />
                                @if (listing.isClosed || listing.isDeleted)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" disabled title="This listing is already closed">
                                        Close
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Close this job listing? Job seekers will no longer be able to apply.');">
                                        Close
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
