@model Job_Portal_Website.Models.JobSeeker
@{
    ViewData["Title"] = "Edit Profile";
}

<h2>Edit Profile</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-controller="Profile" asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="form-group mb-3">
        <label>Full Name</label>
        <input type="text" name="name" value="@Model.seekerName" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label>Email</label>
        <input type="text" value="@Model.seekerEmail" class="form-control" disabled />
        <small class="text-muted">Email can't be changed here.</small>
    </div>

    <div class="form-group mb-3">
        <label>Phone Number</label>
        <input type="text" value="@Model.PhoneNumber" class="form-control" disabled />
    </div>

    <div class="form-group mb-3">
        <label>Skills</label>
        <textarea name="skills" class="form-control" rows="3">@Model.seekerSkills</textarea>
    </div>

    <div class="form-group mb-3">
        <label>Experience</label>
        <textarea name="experience" class="form-control" rows="3">@Model.seekerExp</textarea>
    </div>

    <div class="form-group mb-3">
        <label>Education</label>
        <input type="text" value="@Model.Education" class="form-control" disabled />
    </div>

    <div class="form-group mb-3">
        <label>Resume (PDF or DOCX, max 5MB)</label>
        <input type="file" name="resume" accept=".pdf,.docx" class="form-control" />

        @if (!string.IsNullOrEmpty(Model.resumePath))
        {
            <p class="mt-2">
                Current resume:
                <a href="@Model.resumePath" target="_blank">View uploaded resume</a>
            </p>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>