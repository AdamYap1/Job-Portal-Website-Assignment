@model IEnumerable<Job_Portal_Website.Models.MyApplicationsViewModel>

@{
    ViewData["Title"] = "My Applications";
}

<h2>My Applications</h2>

@if (!string.IsNullOrEmpty(ViewBag.ResumePath as string))
{
    <p>
        Your resume on file:
        <a href="@ViewBag.ResumePath" target="_blank">View Resume</a>
    </p>
}
else
{
    <p>
        No resume on file.
        <a asp-controller="Profile" asp-action="Edit">Upload one here</a>
    </p>
}

@if (TempData["ApplySuccess"] != null)
{
    <div style="color:green">
        <p>@TempData["ApplySuccess"]</p>
    </div>
}

@if (!Model.Any())
{
    <p>You haven't applied to any jobs yet.</p>
}
else
{
    <table border="1" cellpadding="8">
        <thead>
            <tr>
                <th>Job Title</th>
                <th>Company</th>
                <th>Listing Status</th>
                <th>Application Status</th>
                <th>Applied Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var app in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="Listings" asp-action="Details" asp-route-id="@app.JobListId">
                            @app.JobTitle
                        </a>
                    </td>
                    <td>@app.CompanyName</td>
                    <td>
                        @if (app.IsClosed)
                        {
                            <span style="color:gray">Closed</span>
                        }
                        else
                        {
                            <span style="color:green">Open</span>
                        }
                    </td>
                    <td>
                        @{
                            var statusColor = app.ApplyStatus switch
                            {
                                Job_Portal_Website.Models.ApplicationStatus.Accepted => "green",
                                Job_Portal_Website.Models.ApplicationStatus.Rejected => "red",
                                Job_Portal_Website.Models.ApplicationStatus.Viewed => "blue",
                                _ => "black"
                            };
                        }
                        <span style="color:@statusColor; font-weight:bold">@app.DisplayStatus</span>
                    </td>
                    <td>@app.AppliedDate.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (!app.IsClosed && (app.ApplyStatus == Job_Portal_Website.Models.ApplicationStatus.Submitted || app.ApplyStatus == Job_Portal_Website.Models.ApplicationStatus.Viewed))
                        {
                            <form asp-controller="Applications" asp-action="Cancel" method="post" style="display:inline">
                                <input type="hidden" name="applyId" value="@app.ApplyId" />
                                <input type="hidden" name="returnTo" value="myapplications" />
                                <button type="submit" onclick="return confirm('Withdraw this application?');">
                                    Cancel Application
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p><a asp-controller="Listings" asp-action="Search">Browse more jobs</a></p>