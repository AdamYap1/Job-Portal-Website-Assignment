@{
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Job_Portal_Website</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Job_Portal_Website.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav>
            <a asp-controller="Home" asp-action="Index">Job Portal</a>
            <a asp-controller="Listings" asp-action="Search">Search Jobs</a>
            @if (isAuthenticated)
            {
                    @if (User.IsInRole("Employer"))
                    {
                        <a asp-controller="Listings" asp-action="Create">Job Listing</a>
                    <a asp-controller="Listings" asp-action="MyListings">My Job Listings</a>
                    <a asp-controller="Listings" asp-action="MyListings">My Listings</a>

                    } 

                    @if (User.IsInRole("JobSeeker"))
                    {
                    <a asp-controller="Profile" asp-action="Edit">Profile</a>
                        <a asp-controller="Applications" asp-action="MyApplications">My Applications</a>
                    }

                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    <button type="submit">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Login</a>
                <a asp-controller="Account" asp-action="RegisterJobSeeker">Register (Job Seeker)</a>
                <a asp-controller="Account" asp-action="RegisterEmployer">Register (Employer)</a>
            }
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Job_Portal_Website - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
