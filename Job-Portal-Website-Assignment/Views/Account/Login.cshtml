@*
    US-05 — Login. Also displays the success message set by US-01 / US-03
    registration and by US-06 logout.
*@
@{
    ViewData["Title"] = "Login";

    var form = Context.Request.HasFormContentType ? Context.Request.Form : null;
    string Val(string key) => form != null ? form[key].ToString() : string.Empty;

    var successMessage = TempData["SuccessMessage"] as string;
}

<h2>Login</h2>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    @* US-01 / US-03 test 1: "a success message is displayed". *@
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@* Model-level errors only: "Invalid email or password." and
   "Your account is inactive." Field-level errors render beside their field. *@
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<form asp-controller="Account" asp-action="Login" method="post" novalidate>
    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input type="text" id="email" name="email" class="form-control" value="@Val("email")" />
        @Html.ValidationMessage("email", null, new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input type="password" id="password" name="password" class="form-control" />
        @Html.ValidationMessage("password", null, new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Login</button>
</form>

<p class="mt-3">
    Don't have an account?
    <a asp-controller="Account" asp-action="RegisterJobSeeker">Register as Job Seeker</a> |
    <a asp-controller="Account" asp-action="RegisterEmployer">Register as Employer</a>
</p>
